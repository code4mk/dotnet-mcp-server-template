<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packs templates/DotnetMcpTemplate into a NuGet template package: dotnet pack TemplatePack.csproj -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Code4mk.McpServer.Template</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Code4mk MCP Server</Title>
    <Authors>Code4mk</Authors>
    <Description>Production-ready Model Context Protocol (MCP) server for ASP.NET Core (.NET 10, official C# SDK 2.0): tools, resources and prompts; OAuth for any OIDC identity provider (Entra ID, Google, Auth0, Okta, Keycloak) with consent; MCP Apps UI (React + Tailwind); typed API clients; validation; tests; Docker; docs.</Description>
    <PackageTags>dotnet-new;templates;mcp;mcp-server;model-context-protocol;aspnetcore;oauth;oidc;claude;ai;llm;mcp-apps</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/code4mk/dotnet-mcp-server-template</PackageProjectUrl>
    <RepositoryUrl>https://github.com/code4mk/dotnet-mcp-server-template</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- NoDefaultExcludes packs dotfiles (.github, .gitignore, ...) but pack ignores .gitignore: exclude local-only
         files here. Never ship .env: it holds real credentials. .env.example is added back explicitly. -->
    <Content Include="templates/**/*"
             Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/.vs/**;templates/**/.idea/**;templates/**/TestResults/**;templates/**/node_modules/**;templates/**/ui/dist/**;templates/**/.env;templates/**/.env.*;templates/**/.data/**;templates/**/*.user;templates/**/.DS_Store;templates/**/Thumbs.db" />
    <Content Include="templates/**/.env.example" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
