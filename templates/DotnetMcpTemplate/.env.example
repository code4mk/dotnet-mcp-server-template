# Example settings: the only env file committed to git. Copy it to start:
#   cp .env.example .env
# Variables already set in the environment (Docker, CI, shell) always win over .env.
# Keep only placeholders and local-only defaults here, never real secrets.

# ---------------------------------------------------------------- App
# dev | stage | prod  (maps to Development | Staging | Production)
APP_ENV=dev
# Port the server listens on (also used by Docker Compose).
APP_PORT=5080
# Public base URL clients use (behind a proxy: https://mcp.example.com). Empty = http://localhost:${APP_PORT}
APP_URL=

# ---------------------------------------------------------------- MCP
MCP_SERVER_NAME=DotnetMcpTemplate
MCP_PATH=/mcp
# Optional instructions sent to clients (what this server is for).
MCP_INSTRUCTIONS=
# required: every MCP request needs a token (clients log in on connect)
# mixed:    anonymous clients can connect; [Authorize] is checked per tool/resource/prompt
# none:     no login, a fixed developer user is signed in (only allowed when APP_ENV=dev)
MCP_AUTH_MODE=required
# Where built MCP App bundles live. Empty = ui_dist next to the app.
MCP_UI_DIST_DIR=

# ---------------------------------------------------------------- Auth
# oidc (default, proxy for any OIDC identity provider) | jwt (validate IdP tokens directly) | your own provider
AUTH_PROVIDER=oidc

# --- OIDC identity provider (any IdP: Google, Entra ID, Auth0, Okta, Keycloak, Zitadel, ...)
# Register ONE app in your IdP with redirect URI: ${APP_URL}/oauth/callback
OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OIDC_CLIENT_ID=change-me
# Empty = public client (PKCE only).
OIDC_CLIENT_SECRET=
# client_secret_basic | client_secret_post
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid,profile,email
# auto: call userinfo when the IdP advertises it | always | never
OIDC_USERINFO=auto
# Claim holding roles; dot paths work for nested claims, e.g. realm_access.roles
OIDC_ROLE_CLAIM=roles
OIDC_GROUPS_CLAIM=groups
# Extra IdP claims to copy into the server token (comma-separated), e.g. tenant_id,department
OIDC_TOKEN_CLAIMS=
# jwt provider only: accepted token audience(s). Empty = the MCP URL (APP_URL + MCP_PATH).
OIDC_AUDIENCE=

# --- OIDC proxy (the MCP server is the OAuth server for MCP clients)
# Signs server-issued tokens and encrypts stored IdP tokens. 32+ chars: openssl rand -base64 48
AUTH_TOKEN_SIGNING_KEY=development-only-signing-key-change-me-0123456789
# Access tokens are short-lived; clients renew them with the refresh token, no sign-in.
AUTH_TOKEN_LIFETIME_MINUTES=60
# Signed out only after this many days WITHOUT using the server (every refresh starts it again).
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30
# Seconds an old refresh token still returns the same new tokens (concurrent refresh, retry). 0 = off.
AUTH_REFRESH_REUSE_SECONDS=30
# Redirect URIs MCP clients may register (comma-separated; * allowed in port and path).
AUTH_ALLOWED_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*,https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Remember a user's consent for a client for N days (0 = always ask).
AUTH_CONSENT_REMEMBER_DAYS=30
# Where sign-ins live. file: on disk, survives restarts (one instance) | redis: several instances | memory: lost on restart
AUTH_STORE=file
# Folder for AUTH_STORE=file (git-ignored). Docker uses /data/auth on a volume.
AUTH_STORE_PATH=.data/auth
REDIS_URL=

# ---------------------------------------------------------------- API clients (one prefix per data source)
# {PREFIX}_BASE_URL, _TIMEOUT_SECONDS, _RETRY_COUNT, _RETRY_UNSAFE_METHODS, _HEADERS,
# _AUTH = none | bearer | api_key | basic | client_credentials | user
SAMPLE_API_BASE_URL=https://jsonplaceholder.typicode.com/
SAMPLE_API_TIMEOUT_SECONDS=15
SAMPLE_API_RETRY_COUNT=3
SAMPLE_API_AUTH=none
SAMPLE_API_HEADERS=
