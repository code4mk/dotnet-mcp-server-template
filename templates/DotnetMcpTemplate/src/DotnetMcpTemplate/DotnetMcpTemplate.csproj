<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DotnetMcpTemplate</RootNamespace>
    <Version>1.0.0</Version>
    <UserSecretsId>0b0e3a61-6a0d-4e0b-9e53-3e1a1d6b7c07</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Apps" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built MCP App bundles (one self-contained .html per entry) ship next to the app. -->
    <None Include="ui_dist\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetMcpTemplate.UnitTests" />
    <InternalsVisibleTo Include="DotnetMcpTemplate.IntegrationTests" />
    <InternalsVisibleTo Include="DotnetMcpTemplate.ArchitectureTests" />
  </ItemGroup>

</Project>
